{
  "color": {
    "ivory": "#fffaf0",
    "surface": "#ffffff",
    "teal": "#1f3b40",
    "teal-hover": "#1b3438",
    "teal-press": "#182d31",
    "teal-tint": "#d1dfe0",
    "gold": "#d4ba8a",
    "ink": "#262626",
    "muted": "#63615f",
    "line": "rgb(38 38 38 / 0.16)",
    "error": "#8f2d2d",
    "success": "#1e6b45",
    "warning": "#8a3b12",
    "whatsapp": "#25D366"
  },
  "text": {
    "caption": { "size": "12px", "lineHeight": "1.5", "lineHeightAr": "1.7" },
    "label": { "size": "14px", "lineHeight": "1.43", "lineHeightAr": "1.63" },
    "body": { "size": "16px", "lineHeight": "1.5", "lineHeightAr": "1.7" },
    "title": { "size": "20px", "lineHeight": "1.3", "lineHeightAr": "1.5" },
    "heading": { "size": "32px", "lineHeight": "1.2", "lineHeightAr": "1.4" },
    "display": { "size": "48px", "lineHeight": "1.1", "lineHeightAr": "1.3" },
    "hero": { "size": "64px", "lineHeight": "1.05", "lineHeightAr": "1.25" }
  },
  "font": {
    "display": "var(--face-display)",
    "body": "var(--face-body)"
  },
  "face": {
    "display": "var(--font-questa), Georgia, serif",
    "display-ar": "var(--font-noto-naskh), var(--font-questa), Georgia, serif",
    "body": "var(--font-lato), Arial, sans-serif",
    "body-ar": "var(--font-noto-sans), var(--font-lato), Arial, sans-serif"
  },
  "tracking": {
    "kicker": "0.12em",
    "display": "-0.02em"
  },
  "spacing": {
    "control": "44px",
    "chip": "40px",
    "bar": "72px",
    "bar-docked": "56px",
    "summary": "64px",
    "entry": "64px",
    "action": "56px",
    "sheet-head": "60px",
    "dock": "88px",
    "mark": "28px",
    "search": "200px",
    "rail-offset": "112px",
    "row": "56px",
    "row-dense": "44px",
    "chip-dense": "24px"
  },
  "container": {
    "column": "1240px",
    "menu": "440px",
    "calendar": "760px",
    "rail": "400px",
    "dialog": "480px",
    "sidebar": "240px"
  },
  "radius": {
    "control": "0",
    "overlay": "0"
  },
  "shadow": {
    "float": "0 18px 40px -10px rgb(10 9 7 / 0.3), 0 4px 10px -4px rgb(10 9 7 / 0.1)",
    "lg": "0 28px 56px -16px rgb(10 9 7 / 0.28), 0 10px 20px -10px rgb(10 9 7 / 0.12)",
    "rule-primary": "inset 0 -3px 0 var(--color-teal)",
    "rule-error": "inset 0 -3px 0 var(--color-error)",
    "rule-today": "inset 0 -2px 0 var(--color-teal)",
    "selected": "inset 0 0 0 2px var(--color-teal)"
  },
  "ease": {
    "standard": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "transition-duration": {
    "fast": "150ms",
    "mid": "250ms"
  },
  "animate": {
    "panel-in": "panel-in 250ms var(--ease-standard) both",
    "sheet-in": "sheet-in 250ms var(--ease-standard) both",
    "dock-in": "dock-in 150ms var(--ease-standard) both",
    "fade-in": "fade-in 150ms linear both"
  },
  "keyframes": {
    "panel-in": {
      "from": { "opacity": "0", "transform": "translateY(8px)" },
      "to": { "opacity": "1", "transform": "translateY(0)" }
    },
    "sheet-in": {
      "from": { "opacity": "0", "transform": "translateY(8px)" },
      "to": { "opacity": "1", "transform": "translateY(0)" }
    },
    "dock-in": {
      "from": { "opacity": "0", "transform": "translateY(-8px)" },
      "to": { "opacity": "1", "transform": "translateY(0)" }
    },
    "fade-in": {
      "from": { "opacity": "0" },
      "to": { "opacity": "1" }
    }
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  }
}
