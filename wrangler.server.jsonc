// Server-runtime Wrangler file for Worker `almar`, used only by `npm run host:server` and
// `npm run preview:server` (plan 02-08). It has no routes, no secrets and no R2 on purpose:
// plan 02-07 (owner step) adds those and swaps it in for wrangler.toml. Never deploy with it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
